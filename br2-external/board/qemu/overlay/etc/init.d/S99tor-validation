#!/bin/sh
set -eu
[ "${1:-}" = start ] || exit 0
mode=
bootstrap=600
connection=180
idle=10
# The kernel command line is deliberately parsed as whitespace-separated words.
# shellcheck disable=SC2013
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        tor_validate=offline) mode=offline;;
        tor_validate=online) mode=online;;
        tor_bootstrap_timeout=*) bootstrap=${arg#*=};;
        tor_connection_timeout=*) connection=${arg#*=};;
        tor_idle_seconds=*) idle=${arg#*=};;
    esac
done
[ -n "$mode" ] || exit 0
# QEMU's RTC inherits host UTC. Real hardware requires its own trusted time setup.
umask 077
mkdir -p /tmp/tor-validation
export PYTHONUNBUFFERED=1
python3 /opt/tor-validation/tests/run_all.py --mode "$mode" --tor /usr/bin/tor \
    --template /opt/tor-validation/torrc.in --output /tmp/tor-validation/result.json \
    --work-dir /tmp/tor-validation/state --bootstrap-timeout "$bootstrap" \
    --connection-timeout "$connection" --idle-seconds "$idle" || true
if [ -f /tmp/tor-validation/result.json ]; then
    printf '\nTOR_VALIDATION_JSON='
    cat /tmp/tor-validation/result.json
    printf '\nTOR_VALIDATION_END\n'
fi
# The host keeps this VM's serial log and terminates it after the result marker.
sync
poweroff -f
