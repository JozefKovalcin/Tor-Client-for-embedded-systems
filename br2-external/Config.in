# Packages are provided by the hash-pinned Buildroot release.

config BR2_PACKAGE_EMBEDDED_OPENSSL_O2
    bool "Compile OpenSSL with O2 while other userland remains size optimized"
    depends on BR2_PACKAGE_LIBOPENSSL
    help
      Measure selective optimization of the upstream cryptographic/TLS package.
      Preserve the existing library source, algorithms, ABI and hardening.

config BR2_PACKAGE_TOR_CLIENT_ONLY
    bool "Tor client and onion service only"
    depends on BR2_PACKAGE_TOR
    help
      Use upstream's supported client build without relay, bridge-operator,
      directory-cache-server or directory-authority modules. Onion-service
      client/server functionality and cryptographic implementations remain.

config BR2_PACKAGE_TOR_OPTIMIZE_O2
    bool "Compile only Tor with -O2 for measured CPU ablation"
    depends on BR2_PACKAGE_TOR
    help
      Keep the small kernel and size-optimized libraries unchanged while
      measuring the performance/size effect of Tor's compiler optimization.
      Global Buildroot/toolchain hardening remains enabled.

config BR2_PACKAGE_TOR_GC_SECTIONS
    bool "Discard unreachable code and diagnostic executable symbol exports"
    depends on BR2_PACKAGE_TOR
    depends on BR2_TOOLCHAIN_USES_MUSL
    help
      Dedicated executable with network/control interfaces, not a shared
      library or plugin API. Remove -rdynamic, which upstream adds for
      diagnostic backtrace symbolization unavailable in this musl build,
      and garbage-collect unreachable function/data sections. Preserve
      unwind tables, CET, stack protection, PIE and full RELRO.
