BR2_x86_64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/../build/toolchains/baseline-sdk"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="x86_64-buildroot-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_18=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/patches"
BR2_OPTIMIZE_S=y
BR2_SSP_STRONG=y
BR2_PIC_PIE=y
BR2_RELRO_FULL=y
BR2_TARGET_GENERIC_HOSTNAME="embedded-tor-lab"
BR2_TARGET_GENERIC_ISSUE="Tor validation laboratory; no hardware verification"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-production/overlay $(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-compressed/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-compressed/post-build.sh"
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-ram/busybox.config"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-selective/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_TOR=y
BR2_PACKAGE_LIBSECCOMP=y
# BR2_TARGET_ROOTFS_EXT2 is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_TOR_CLIENT_ONLY=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-production/users.txt"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EMBEDDED_TOR_PATH)/board/qemu-capacity32/post-image.sh"
BR2_PACKAGE_TOR_OPTIMIZE_O2=y
BR2_PACKAGE_TOR_GC_SECTIONS=y
BR2_LINUX_KERNEL_XZ=y
BR2_PACKAGE_EMBEDDED_OPENSSL_O2=y
