<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TorManager.Desktop.Presentation"
        x:Class="TorManager.Desktop.MainWindow"
        Title="Tor Manager"
        Width="1240" Height="860" MinWidth="820" MinHeight="580"
        Background="{DynamicResource WorkspaceBackground}" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="15"
        x:CompileBindings="False">
  <Window.Styles>
    <StyleInclude Source="avares://Tor.Desktop/WorkspaceStyles.axaml" />
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:PageViewModel}">
      <ScrollViewer>
        <StackPanel Margin="30,24,30,20" Spacing="16">
          <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted" MaxWidth="840" HorizontalAlignment="Left" />
          <StackPanel IsVisible="{Binding ShowDeveloper}" Spacing="10">
            <Border Classes="card" DataContext="{Binding $parent[Window].DataContext.Developer}">
              <StackPanel Spacing="10">
                <StackPanel IsEnabled="{Binding Idle}" Spacing="6">
                  <TextBlock Classes="label" Text="Verified archive directory" />
                  <TextBox Text="{Binding Sources}" AutomationProperties.Name="Verified archive directory" />
                  <TextBlock Classes="label" Text="Private build workspace" />
                  <TextBox Text="{Binding Workspace}" AutomationProperties.Name="Private build workspace" />
                  <TextBlock Classes="label" Text="Build profile" />
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Build profile" />
                </StackPanel>
                <Border Classes="live">
                  <TextBlock Classes="live" Text="{Binding Status}" TextWrapping="Wrap" />
                </Border>
                <Button Content="Cancel operation" Command="{Binding CancelCommand}" />
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding ShowDeveloperDependencies}">
              <StackPanel DataContext="{Binding $parent[Window].DataContext.Developer}" Spacing="8">
                <WrapPanel>
                  <Button Classes="primary" Content="Scan PC" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                  <Button Content="Prepare installation plan" Command="{Binding PlanCommand}" />
                </WrapPanel>
                <SelectableTextBlock Text="{Binding PlanDetails}" FontFamily="Consolas, monospace" TextWrapping="Wrap" />
                <CheckBox Content="I approve this exact installation plan" IsChecked="{Binding Confirmed}" IsEnabled="{Binding Idle}" />
                <Button Content="Install approved packages" Command="{Binding InstallCommand}" />
                <ItemsControl ItemsSource="{Binding Dependencies}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Classes="live" Text="{Binding Status}" />
                          </Grid>
                          <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Classes="muted" />
                          <TextBlock Text="{Binding Method}" TextWrapping="Wrap" Classes="muted" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowDeveloperBuild}">
              <WrapPanel DataContext="{Binding $parent[Window].DataContext.Developer}">
                <Button Content="Run preflight" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Classes="primary" Content="Compile verified sources" Command="{Binding BuildCommand}" />
              </WrapPanel>
            </StackPanel>
            <StackPanel IsVisible="{Binding ShowDeveloperArtifacts}">
              <StackPanel DataContext="{Binding $parent[Window].DataContext.Developer}" Spacing="8">
                <Button Content="Refresh builds" Command="{Binding ListCommand}" />
                <TextBlock Classes="label" Text="Build" />
                <ComboBox ItemsSource="{Binding Builds}" SelectedItem="{Binding Selected}" IsEnabled="{Binding Idle}"
                          AutomationProperties.Name="Build">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="label" Text="Compare with" />
                <ComboBox ItemsSource="{Binding Builds}" SelectedItem="{Binding CompareWith}" IsEnabled="{Binding Idle}"
                          AutomationProperties.Name="Compare with">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Run offline smoke" Command="{Binding SmokeCommand}" />
                <Button Classes="primary" Content="Export verified runtime ZIP" Command="{Binding ExportCommand}" />
                <TextBlock Text="Export is available after an offline smoke test passes. The ZIP is saved in the workspace’s exports folder."
                           TextWrapping="Wrap" Classes="muted" />
                <CheckBox Content="I approve this verified local build for future Tor sessions" IsChecked="{Binding ApproveRuntime}" IsEnabled="{Binding Idle}" />
                <WrapPanel>
                  <Button Content="Activate approved build" Command="{Binding ActivateCommand}" Margin="0,0,8,0" />
                  <Button Content="Roll back runtime" Command="{Binding RollbackCommand}" />
                </WrapPanel>
                <TextBlock Text="Activation and rollback take effect after restarting Tor Manager." TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
            </StackPanel>
            <Border Classes="log" DataContext="{Binding $parent[Window].DataContext.Developer}">
              <StackPanel Spacing="8">
              <SelectableTextBlock Text="{Binding Report}" FontFamily="Consolas, monospace" TextWrapping="Wrap" />
              <SelectableTextBlock Text="{Binding Log}" FontFamily="Consolas, monospace" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding ShowOffline}" Spacing="10">
            <Border Classes="card" IsVisible="{Binding $parent[Window].DataContext.HasOfflineUnavailableReason}">
              <TextBlock Text="{Binding $parent[Window].DataContext.OfflineUnavailableReason}" TextWrapping="Wrap" />
            </Border>
            <StackPanel IsVisible="{Binding $parent[Window].DataContext.HasOffline}"
                        DataContext="{Binding $parent[Window].DataContext.Offline}" Spacing="10">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Tor session" Classes="section" />
                  <Border Classes="live">
                    <TextBlock Classes="live" Text="{Binding SessionText}" TextWrapping="Wrap" />
                  </Border>
                  <WrapPanel>
                    <Button Classes="primary" Content="Start Tor" Command="{Binding StartCommand}" Margin="0,0,8,4" />
                    <Button Content="Stop Tor" Command="{Binding StopCommand}" Margin="0,0,8,4" />
                    <Button Content="Check runtime" Command="{Binding RefreshCommand}" Margin="0,0,8,4" />
                  </WrapPanel>
                  <TextBlock Text="{Binding PackageText}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding $parent[Window].DataContext.ActiveRuntime}" Classes="live" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ProcessText}" Classes="muted" />
                  <StackPanel IsVisible="{Binding IsOnline}" Spacing="5">
                    <TextBlock Text="{Binding TorVersionText}" TextWrapping="Wrap" />
                    <TextBlock Text="Tor executable SHA-256" Classes="label" />
                    <TextBlock Text="{Binding RuntimeDigest}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Control connection" Classes="label" />
                    <TextBlock Classes="live" Text="{Binding ControlText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Bootstrap" Classes="label" />
                    <TextBlock Classes="live" Text="{Binding BootstrapText}" TextWrapping="Wrap" />
                    <ProgressBar IsVisible="{Binding ShowBootstrapProgress}" IsIndeterminate="{Binding BootstrapIndeterminate}"
                                 Minimum="0" Maximum="100" Value="{Binding BootstrapValue}" />
                    <TextBlock Text="Network access is disabled in this workspace." IsVisible="{Binding !IsOnline}"
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="card" IsVisible="{Binding IsOnline}">
                <StackPanel Spacing="10">
                  <TextBlock Text="SOCKS5 and connectivity" Classes="section" />
                  <TextBlock Classes="live" Text="{Binding SocksStatusText}" TextWrapping="Wrap" />
                  <TextBlock Classes="live" Text="{Binding CircuitStatusText}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Local SOCKS5 port" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SocksPortText, Mode=TwoWay}" IsEnabled="{Binding CanEditSocksPort}" Width="95"
                             MaxLength="5" AutomationProperties.Name="Local SOCKS5 port" />
                  </StackPanel>
                  <TextBlock Text="Enter a port between 1 and 65535." IsVisible="{Binding InvalidSocksPort}"
                             Classes="attention" TextWrapping="Wrap" />
                  <TextBlock Text="Configure each client to resolve hostnames through SOCKS5. The listener is accessible to local processes."
                             Classes="muted" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Test through Tor" Command="{Binding CheckConnectivityCommand}" />
                    <Button Content="New Identity" Command="{Binding NewIdentityCommand}" />
                    <Button Content="Restart Tor" Command="{Binding RestartCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding OnlineNotice}" IsVisible="{Binding HasOnlineNotice}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <TextBlock Text="Current task" FontWeight="SemiBold" />
                  <TextBlock Classes="live" Text="{Binding TaskText}" />
                  <TextBlock Text="{Binding OutcomeText}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RecoveryText}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                             Classes="attention" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowPeers}">
            <Border Classes="live" Margin="0,0,0,14"
                    DataContext="{Binding $parent[Window].DataContext.Offline.Peer}">
              <TextBlock Classes="live" Text="{Binding Status}" TextWrapping="Wrap" />
            </Border>
            <Border Classes="card" DataContext="{Binding $parent[Window].DataContext.Offline.Peer}">
              <StackPanel Spacing="10">
                <TextBlock Text="Peer identity and contacts" Classes="section" />
                <TextBlock Text="Exchange fingerprints through a trusted channel before connecting." Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="Your certificate SHA-256" Classes="label" />
                <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, monospace"
                         AutomationProperties.Name="Your certificate fingerprint" />
                <Button Content="Create local peer identity" Command="{Binding CreateIdentityCommand}" />
                <Expander Header="Local TLS identity recovery" IsVisible="{Binding HasPrivateProfile}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="muted" Text="Keep a DPAPI-protected copy for this Windows account so you can restore the same local certificate."
                               TextWrapping="Wrap" />
                    <Button Content="Save protected recovery copy" Command="{Binding SaveRecoveryCommand}" />
                    <CheckBox Content="I confirm recovery of the original local TLS identity"
                              IsEnabled="{Binding CanApproveIdentityRecovery}" IsChecked="{Binding ApproveIdentityRecovery}" />
                    <Button Content="Recover original TLS identity" Command="{Binding RecoverIdentityCommand}" />
                    <TextBlock Classes="live" Text="{Binding RecoveryNotice}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="Paired contact" Classes="label" />
                <ComboBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedPeer}" IsEnabled="{Binding CanEditPeer}"
                          HorizontalAlignment="Stretch" PlaceholderText="Select a paired contact"
                          AutomationProperties.Name="Paired contact">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <SelectableTextBlock Text="{Binding SelectedPeer.Fingerprint}" TextWrapping="Wrap"
                                     AutomationProperties.Name="Selected contact fingerprint" />
                <TextBox Text="{Binding OnionAddress, Mode=TwoWay}" IsEnabled="{Binding CanEditSelectedPeer}" MaxLength="62"
                         PlaceholderText="Selected contact’s v3 onion address" AutomationProperties.Name="Selected contact onion address" />
                <WrapPanel>
                  <Button Content="Save contact address" Command="{Binding SaveEndpointCommand}" Margin="0,0,8,4" />
                  <Button Content="Revoke selected contact" Command="{Binding RevokePeerCommand}" Margin="0,0,8,4" />
                </WrapPanel>
                <Expander Header="Pair a contact or replace a certificate">
                  <StackPanel Spacing="6">
                    <TextBox Text="{Binding Label}" IsEnabled="{Binding CanEditPeer}" MaxLength="64"
                             PlaceholderText="Contact name" AutomationProperties.Name="Contact name for pairing" />
                    <TextBox Text="{Binding PeerFingerprint, Mode=TwoWay}" IsEnabled="{Binding CanEditPeer}" MaxLength="64"
                             PlaceholderText="Certificate SHA-256" AutomationProperties.Name="Certificate fingerprint for pairing" />
                    <TextBox Text="{Binding PairingAddress, Mode=TwoWay}" IsEnabled="{Binding CanEditPeer}" MaxLength="62"
                             PlaceholderText="Optional v3 onion address" AutomationProperties.Name="Onion address for pairing" />
                    <CheckBox IsChecked="{Binding ComparedFingerprint}" IsEnabled="{Binding CanEditPeer}"
                              Content="I compared this fingerprint over a trusted channel" />
                    <Button Classes="primary" Content="Pair contact" Command="{Binding SavePeerCommand}" />
                    <Button Content="Revoke old pin and pair replacement" Command="{Binding RotatePeerCommand}" />
                    <TextBlock Text="Replacing the selected contact’s certificate starts a fresh conversation. Queued messages stay with the old certificate."
                               Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border Classes="card" DataContext="{Binding $parent[Window].DataContext.Offline.Peer}">
              <StackPanel Spacing="10">
                <TextBlock Text="Onion Service hosting" Classes="section" />
                <TextBlock Text="{Binding HostingStatus}" Classes="live" TextWrapping="Wrap" />
                <TextBox Text="{Binding SavedHostingAddress, Mode=OneWay}" IsReadOnly="True"
                         PlaceholderText="Saved v3 onion address" AutomationProperties.Name="Saved v3 onion address" />
                <WrapPanel>
                  <Button Classes="primary" Content="Host saved address" Command="{Binding HostCommand}" Margin="0,0,8,4" />
                  <Button Classes="primary" Content="Create and host saved address" Command="{Binding CreateHostingCommand}" Margin="0,0,8,4" />
                  <Button Content="Host temporarily" Command="{Binding TransientHostCommand}" Margin="0,0,8,4" />
                </WrapPanel>
                <Expander Header="Rotate saved hosting address" IsEnabled="{Binding CanApproveHostingRotation}">
                  <StackPanel Spacing="6">
                    <CheckBox Content="Replace the saved address. I will share the new address with my contacts."
                              IsChecked="{Binding ApproveHostingRotation}" />
                    <Button Content="Replace and host new address" Command="{Binding RotateHostingCommand}" />
                  </StackPanel>
                </Expander>
                <TextBox Text="{Binding HostedAddress, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Your hosted v3 onion address"
                         AutomationProperties.Name="Your hosted v3 onion address" />
              </StackPanel>
            </Border>
            <Border Classes="card" DataContext="{Binding $parent[Window].DataContext.Offline.Peer}">
              <StackPanel Spacing="10">
                <TextBlock Text="Peer connection and messages" Classes="section" />
                <WrapPanel>
                  <Button Classes="primary" Content="Connect to Peer" Command="{Binding ConnectCommand}" Margin="0,0,8,4" />
                  <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                </WrapPanel>
                <TextBox Text="{Binding Draft, Mode=TwoWay}" IsEnabled="{Binding HasDeliveryTarget}" PlaceholderText="Message" MaxLength="8192"
                         AutomationProperties.Name="Message" />
                <Button Classes="primary" Content="Send or queue" Command="{Binding SendCommand}" HorizontalAlignment="Left" />
                <TextBlock Classes="live" Text="{Binding DeliveryNotice}" TextWrapping="Wrap" />
                <Expander Header="Recent connection events" IsVisible="{Binding HasDeliveryTarget}">
                  <ItemsControl ItemsSource="{Binding ConnectionHistory}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
                <StackPanel IsVisible="{Binding HasDeliveryTarget}" Spacing="6">
                  <TextBlock Text="Recent messages" FontWeight="SemiBold" />
                  <TextBlock Text="Pending and received text is encrypted locally during the 15-minute delivery window."
                             Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding DeliveryRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,4" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Direction}" FontWeight="SemiBold" />
                            <TextBlock Classes="live" Text="{Binding Status}" />
                            <TextBlock Text="{Binding Id}" Classes="muted" />
                          </StackPanel>
                          <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Expander Header="Encrypted history">
                    <StackPanel Spacing="5">
                      <CheckBox Content="Archive new delivered messages" IsChecked="{Binding SaveHistory}"
                                IsEnabled="{Binding HasDeliveryTarget}" />
                      <TextBlock Text="Up to 64 messages for seven days. Turning this off stops new archival."
                                 Classes="muted" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding HistoryRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,4" Spacing="2">
                              <TextBlock Text="{Binding Direction}" FontWeight="SemiBold" />
                              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>
                </StackPanel>
                <TextBlock Text="{Binding LastMessage}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding ShowTasks}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,10">
              <TextBlock Text="{Binding $parent[Window].DataContext.TaskHeading}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Replay simulation" Command="{Binding $parent[Window].DataContext.ReplayCommand}"
                      IsVisible="{Binding $parent[Window].DataContext.IsDemo}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.VisibleTasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card">
                    <StackPanel Spacing="9">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding TaskId}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Phase}" Classes="muted" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#111820" CornerRadius="4" Padding="8,3">
                          <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateColor}" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="5"
                                   IsVisible="{Binding ShowProgress}" IsIndeterminate="{Binding IsActiveIndeterminate}" />
                      <TextBlock Text="{Binding ProgressText}" FontSize="12" Classes="muted" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Event log · newest retained within 100 entries" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.VisibleLogs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="log" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding TaskId}" FontSize="13" Classes="label" />
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <ItemsControl IsVisible="{Binding ShowDependencies}" ItemsSource="{Binding $parent[Window].DataContext.Dependencies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Requirement}" FontWeight="SemiBold" />
                      <Border Grid.Column="1" Background="#111820" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StateColor}" FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding Version}" Classes="muted" />
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding ShowSettings}" Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="Application preferences" Classes="section" />
              <TextBlock Text="Appearance" Classes="label" />
              <ComboBox Width="230" HorizontalAlignment="Left"
                        ItemsSource="{Binding $parent[Window].DataContext.Themes}"
                        SelectedItem="{Binding $parent[Window].DataContext.Theme, Mode=TwoWay}"
                        AutomationProperties.Name="Appearance" />
              <CheckBox Content="Animate the bounded simulated task stream"
                        IsChecked="{Binding $parent[Window].DataContext.AnimateSimulation, Mode=TwoWay}" />
              <Button Classes="primary" Content="Save UI preferences" HorizontalAlignment="Left"
                      Command="{Binding $parent[Window].DataContext.SaveSettingsCommand}" />
              <TextBlock Classes="muted" Text="Saving keeps the selected connection and workspace for your next launch. Tor starts when you choose Start Tor."
                         TextWrapping="Wrap" />
              <StackPanel Spacing="7" IsVisible="{Binding $parent[Window].DataContext.CanChooseRuntime}">
                <TextBlock Text="Tor runtime" FontWeight="SemiBold" />
                <TextBlock Text="{Binding $parent[Window].DataContext.ActiveRuntime, StringFormat='Active runtime · {0}'}"
                           Classes="live" TextWrapping="Wrap" />
                <TextBlock Text="{Binding $parent[Window].DataContext.RuntimePreference}" Classes="muted" TextWrapping="Wrap" />
                <WrapPanel>
                  <Button Content="Use bundled on restart" Margin="0,0,8,4"
                          Command="{Binding $parent[Window].DataContext.SelectBundledRuntimeCommand}" />
                  <Button Content="Use approved build on restart"
                          Command="{Binding $parent[Window].DataContext.SelectCustomRuntimeCommand}" />
                </WrapPanel>
              </StackPanel>
              <TextBlock Text="{Binding $parent[Window].DataContext.SettingsNotice}" TextWrapping="Wrap" Classes="muted" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="222,*" RowDefinitions="Auto,*,Auto">
    <Border Grid.RowSpan="3" Background="{DynamicResource WorkspaceSidebar}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Margin="20,22,20,18" Padding="0,0,0,13" BorderThickness="0,0,0,3"
                BorderBrush="{DynamicResource WorkspaceAccent}">
          <TextBlock Text="Tor Manager" FontWeight="Bold" FontSize="24" />
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                 Classes="navigation" AutomationProperties.Name="Pages"
                 Background="Transparent" BorderThickness="0" Margin="10,0">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Margin="12,16" Classes="live">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding ModeHeading}" FontSize="13" Classes="label" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SidebarStatus}" Classes="live" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource WorkspaceCard}"
            BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,0,0,1" Padding="30,14">
      <StackPanel Spacing="8">
        <WrapPanel>
          <StackPanel Spacing="4" Margin="0,0,18,4">
            <TextBlock Text="Connection" Classes="label" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Demo" Command="{Binding ShowDemoCommand}" Classes.selected="{Binding IsDemo}" />
              <Button Content="Real Offline" Command="{Binding ShowRealOfflineCommand}" Classes.selected="{Binding IsRealOffline}" />
              <Button Content="Real Online" Command="{Binding ShowRealOnlineCommand}" IsVisible="{Binding HasOnline}"
                      Classes.selected="{Binding IsOnline}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding HasDeveloper}">
            <TextBlock Text="Workspace" Classes="label" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Run Only" Command="{Binding ShowRunOnlyCommand}" Classes.selected="{Binding !IsDeveloper}" />
              <Button Content="Developer" Command="{Binding ShowDeveloperCommand}" Classes.selected="{Binding IsDeveloper}" />
            </StackPanel>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentPage}" />
    <Border Grid.Column="1" Grid.Row="2" Background="{DynamicResource WorkspaceSidebar}" Padding="24,16" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding TaskSummary}" Classes="live" FontSize="13" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Classes="muted" FontSize="13" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
