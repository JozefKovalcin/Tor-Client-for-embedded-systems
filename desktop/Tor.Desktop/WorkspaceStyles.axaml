<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceForeground}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.live">
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceLive}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.attention">
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceAttention}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource WorkspaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Border.live">
    <Setter Property="Background" Value="{DynamicResource WorkspaceLiveSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceLiveBorder}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.log">
    <Setter Property="Background" Value="{DynamicResource WorkspaceLog}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="39" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource WorkspaceAction}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceActionBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceForeground}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspaceForeground}" />
  </Style>
  <Style Selector="Button.primary, Button.selected">
    <Setter Property="Background" Value="{DynamicResource WorkspacePrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspacePrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspacePrimaryText}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspacePrimaryHover}" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspacePrimaryText}" />
  </Style>
  <Style Selector="Button.selected:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspacePrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspacePrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource WorkspacePrimaryText}" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="ComboBox, TextBox">
    <Setter Property="MinHeight" Value="39" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox, CheckBox, Expander">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="TextBox:read-only">
    <Setter Property="Background" Value="{DynamicResource WorkspaceLog}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="Padding" Value="15,10" />
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceAction}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WorkspaceHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceFocus}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
