<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RuntimeFrameworkVersion>11.0.0</RuntimeFrameworkVersion>
    <RootNamespace>TorManager.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == 'win-x64'">$(MSBuildThisFileDirectory)packages.win-x64.lock.json</NuGetLockFilePath>
    <NuGetAudit>true</NuGetAudit>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tor.Application/Tor.Application.csproj" />
    <PackageReference Include="Avalonia" Version="[12.1.6]" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.1.6]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.6]" />
    <EmbeddedResource Include="SampleData/*.json" LogicalName="TorManager.Desktop.SampleData.%(Filename)%(Extension)" />
    <Content Include="../../scripts/windows_developer/*.py" Link="developer/scripts/windows_developer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/dependencies/*.py" Link="developer/scripts/dependencies/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../scripts/contracts.py" Link="developer/scripts/contracts.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../config/contracts/v1/*.json" Link="developer/config/contracts/v1/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../config/dependencies/manifest-v1.json" Link="developer/config/dependencies/manifest-v1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../windows-native/build-windows.sh;../../windows-native/source-manifest.json;../../windows-native/RUNTIME.md"
             Link="developer/windows-native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../windows-native/scripts/prepare.py;../../windows-native/scripts/package.sh;../../windows-native/scripts/package.py;../../windows-native/scripts/start-tor.cmd;../../windows-native/scripts/smoke-test.ps1"
             Link="developer/windows-native/scripts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../windows-native/config/*" Link="developer/windows-native/config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../windows-native/patches/*" Link="developer/windows-native/patches/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <Content Include="../../scripts/native_linux/*.py" Link="developer/scripts/native_linux/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../config/native-linux/v1.json" Link="developer/config/native-linux/v1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../config/sources.lock.json" Link="developer/config/sources.lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../config/upstream/*.hash" Link="developer/config/upstream/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
