{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tor-client:contracts:v1:TaskProgress",
  "title": "TaskProgress",
  "description": "TASK 01 v1 contract. Cross-field invariants are enforced by scripts/contracts.py; see config/contracts/README.md.",
  "$defs": {
    "Ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?:/[A-Za-z0-9][A-Za-z0-9_.-]*)*$(?![\\s\\S])",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|/)(?:[cC][oO][nN][tT][rR][oO][lL]_[aA][uU][tT][hH]_[cC][oO][oO][kK][iI][eE]|[hH][sS]_[eE][dD]25519_[sS][eE][cC][rR][eE][tT]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[dD][aA][tT][aA][dD][iI][rR][eE][cC][tT][oO][rR][yY]|[hH][iI][dD][dD][eE][nN]_[sS][eE][rR][vV][iI][cC][eE]|[dD][aA][tT][aA]-[oO][nN][iI][oO][nN]|[oO][nN][iI][oO][nN]-[sS][eE][rR][vV][iI][cC][eE])(?:/|$)"
          },
          {
            "pattern": "\\.(?:[pP][eE][mM]|[kK][eE][yY]|[cC][oO][oO][kK][iI][eE]|[pP][fF][xX]|[pP]12)$(?![\\s\\S])"
          }
        ]
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "Metric": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "enum": [
            "B",
            "s",
            "B/s",
            "%",
            "count"
          ]
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "method",
        "unavailableReason"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "taskId": {
      "$ref": "#/$defs/Ref"
    },
    "parentTaskId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "cancelled",
        "succeeded",
        "failed",
        "blocked",
        "interrupted"
      ]
    },
    "completed": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "total": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "unit": {
      "enum": [
        "B",
        "steps",
        "%",
        null
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cancellationSupported": {
      "type": "boolean"
    },
    "retryOfTaskId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "rawExitCode": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "terminationSignal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 127
    },
    "reasonCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "logRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "taskId",
    "parentTaskId",
    "sequence",
    "timestampUtc",
    "phase",
    "state",
    "completed",
    "total",
    "unit",
    "message",
    "cancellationSupported",
    "retryOfTaskId",
    "rawExitCode",
    "terminationSignal",
    "reasonCode",
    "logRef"
  ],
  "additionalProperties": false
}
