{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tor-client:contracts:v1:TestResult",
  "title": "TestResult",
  "description": "TASK 01 v1 contract. Cross-field invariants are enforced by scripts/contracts.py; see config/contracts/README.md.",
  "$defs": {
    "Ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?:/[A-Za-z0-9][A-Za-z0-9_.-]*)*$(?![\\s\\S])",
      "not": {
        "anyOf": [
          {
            "pattern": "(?:^|/)(?:[cC][oO][nN][tT][rR][oO][lL]_[aA][uU][tT][hH]_[cC][oO][oO][kK][iI][eE]|[hH][sS]_[eE][dD]25519_[sS][eE][cC][rR][eE][tT]_[kK][eE][yY]|[pP][rR][iI][vV][aA][tT][eE]_[kK][eE][yY]|[dD][aA][tT][aA][dD][iI][rR][eE][cC][tT][oO][rR][yY]|[hH][iI][dD][dD][eE][nN]_[sS][eE][rR][vV][iI][cC][eE]|[dD][aA][tT][aA]-[oO][nN][iI][oO][nN]|[oO][nN][iI][oO][nN]-[sS][eE][rR][vV][iI][cC][eE])(?:/|$)"
          },
          {
            "pattern": "\\.(?:[pP][eE][mM]|[kK][eE][yY]|[cC][oO][oO][kK][iI][eE]|[pP][fF][xX]|[pP]12)$(?![\\s\\S])"
          }
        ]
      }
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "Metric": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "enum": [
            "B",
            "s",
            "B/s",
            "%",
            "count"
          ]
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "unit",
        "method",
        "unavailableReason"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "$ref": "#/$defs/Ref"
    },
    "testId": {
      "$ref": "#/$defs/Ref"
    },
    "taskId": {
      "$ref": "#/$defs/Ref"
    },
    "targetId": {
      "$ref": "#/$defs/Ref"
    },
    "scope": {
      "enum": [
        "unit",
        "host-native",
        "simulation",
        "physical"
      ]
    },
    "mode": {
      "enum": [
        "offline",
        "online"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "SKIPPED",
        "BLOCKED",
        "NOT RUN"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "protocolId": {
      "$ref": "#/$defs/Ref"
    },
    "policySha256": {
      "$ref": "#/$defs/Sha256"
    },
    "startedAtUtc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "durationSeconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "rawExitCode": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4294967295
    },
    "logRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "artifactIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      }
    },
    "environmentRef": {
      "$ref": "#/$defs/Ref"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "testId",
    "taskId",
    "targetId",
    "scope",
    "mode",
    "status",
    "reason",
    "protocolId",
    "policySha256",
    "startedAtUtc",
    "durationSeconds",
    "rawExitCode",
    "logRefs",
    "artifactIds",
    "metrics",
    "environmentRef"
  ],
  "additionalProperties": false
}
